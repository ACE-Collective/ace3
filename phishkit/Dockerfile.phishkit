ARG DOCKER_IMAGE_PREFIX=docker.io
FROM ${DOCKER_IMAGE_PREFIX}/library/ubuntu:22.04

# env vars
ENV DEBIAN_FRONTEND=noninteractive

# install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libgtk-4-1 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libvulkan1 \
    libx11-6 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    wget \
    xdg-utils \
    python3.10-venv \
    xvfb \
    python3-tk \
    python3-dev \
    zsh \
    git \
    ffmpeg \
    gnome-screenshot

# install google chrome (architecture-aware)
RUN ARCH=$(dpkg --print-architecture) && \
    curl -k -L "https://dl.google.com/linux/direct/google-chrome-stable_current_${ARCH}.deb" -o /tmp/google-chrome-stable.deb && \
    dpkg -i /tmp/google-chrome-stable.deb || apt-get install -f -y && \
    rm /tmp/google-chrome-stable.deb

# install python venv
RUN python3 -m venv /opt/venv

COPY phishkit/requirements.phishkit.txt /opt/app/requirements.txt

# install dependencies
RUN /opt/venv/bin/pip install -U pip \
    && /opt/venv/bin/pip install -r /opt/app/requirements.txt

RUN /opt/venv/bin/seleniumbase install chromedriver

# seleniumbase installs the x86-64 chromedriver on every Linux host, so on arm64 replace it with
# the Chrome for Testing linux-arm64 build of the installed Chrome's exact version (a driver from
# another major refuses to start). uc mode copies chromedriver to uc_driver and patches that
# copy, so replacing chromedriver is enough
RUN if [ "$(dpkg --print-architecture)" = "arm64" ]; then \
        VERSION=$(google-chrome --version | grep -oE '[0-9]+(\.[0-9]+){3}') && \
        DRIVERS=$(/opt/venv/bin/python -c 'import os, seleniumbase; print(os.path.join(os.path.dirname(seleniumbase.__file__), "drivers"))') && \
        curl -fsSLk "https://storage.googleapis.com/chrome-for-testing-public/${VERSION}/linux-arm64/chromedriver-linux-arm64.zip" -o /tmp/chromedriver.zip && \
        /opt/venv/bin/python -c "import zipfile; zipfile.ZipFile('/tmp/chromedriver.zip').extractall('/tmp/chromedriver')" && \
        install -m 755 /tmp/chromedriver/chromedriver-linux-arm64/chromedriver "${DRIVERS}/chromedriver" && \
        rm -rf /tmp/chromedriver /tmp/chromedriver.zip; \
    fi

RUN mkdir /export
COPY phishkit/scanner.py /opt/app/scanner.py
COPY etc/phishkit_config.yaml /opt/app/phishkit_config.yaml

VOLUME ["/export"]

WORKDIR /opt/app