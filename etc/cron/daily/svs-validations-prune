#!/usr/bin/env bash
source /opt/ace/bin/initialize-environment.sh

# remove the svs yara validations (docs/SVS_VALIDATION.md) that finished more than
# svs.yara.retention_days ago, with their results, in small batches. the command exits 0 without
# doing anything unless ACE_IS_PRIMARY_NODE is 1, because the validations are shared state.
ace svs yara prune
