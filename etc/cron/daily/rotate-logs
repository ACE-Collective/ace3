#!/usr/bin/env bash
source /opt/ace/bin/initialize-environment.sh

# compress logs older than N days
COMPRESS_LOGS_OLDER_THAN=3

# delete compressed logs older than N days
DELETE_LOGS_OLDER_THAN=30

# these steps stay in one task because each depends on the one before it

# rotate the logs being generated by fluent-bit
/usr/sbin/logrotate -s data/var/logrotate.state -f etc/logrotate.conf

# if any integrations define a logrotate configuration, run those as well
ace integration list | awk 'NR>2 && $2=="ENABLED" {print $1, $4}' | while read integration_name integration_dir
do
    if [ -e "${integration_dir}/etc/logrotate.conf" ]
    then
        echo "running logrotate for $integration_name"
        /usr/sbin/logrotate -s data/var/logrotate.state."$integration_name" -f "${integration_dir}/etc/logrotate.conf"
    fi
done

# compress logs older than N day (except for the static error logs)
find -L data/logs -name '*.log' ! -name '*_error.log' -mtime +$COMPRESS_LOGS_OLDER_THAN -exec gzip '{}' \;

# clear compressed logs older than N days
find -L data/logs -mindepth 1 -maxdepth 1 -name '*.log.gz' -mtime +$DELETE_LOGS_OLDER_THAN -delete
