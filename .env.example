#
# Copy to .env and edit. Every variable here has a working default, so an ordinary
# single-instance development environment needs no .env at all.
#
# For a SECOND instance on the same host, do not hand-write this file -- generate it:
#
#     bin/generate-instance-env.sh ace2 100 > .env
#
# See docs/MULTI_INSTANCE.md.
#

# ---------------------------------------------------------------------------
# stack identity
# ---------------------------------------------------------------------------

# The compose project name. This is the one knob that separates stacks: it prefixes every
# container, the network and all ten named volumes, so ace2 gets ace2_data, ace2_db, ace2_auth,
# the ace2_ace network and containers named ace2-*.
#
# Not to be confused with ACE_INSTANCE_NAME (the label analysts see in the GUI) or
# ACE_INSTANCE_TYPE (which decides the Flask config and which services may run). This one is
# docker identity only -- no ACE code reads it.
#
# Must be lowercase [a-z0-9][a-z0-9_-]* -- compose normalizes project names, and a name that
# changes under normalization would no longer match the volume names handed to the phishkit and
# js-deobfuscator managers.
#
# Do NOT set COMPOSE_PROJECT_NAME as well. It overrides the top-level name: in
# docker-compose.yml, which would desynchronize the two.
#ACE_STACK=ace

# What this stack calls itself in the GUI (global.instance_name).
#ACE_INSTANCE_NAME=DEV

# DEV | QA | PRODUCTION
#ACE_INSTANCE_TYPE=DEV

# ---------------------------------------------------------------------------
# host ports
# ---------------------------------------------------------------------------

# The interface every published port binds to. Set to 0.0.0.0 to reach this instance from
# another machine on the network.
#ACE_BIND_ADDRESS=127.0.0.1

# Only these five get a fixed host port. mysql, redis, rabbitmq, qdrant and the network
# semaphore are published on an ephemeral port instead -- find one with:
#
#     docker compose port ace-db 3306
#
# ACE_PORT_FLUENT_BIT cannot be made ephemeral: the fluentd log driver address is resolved by
# the docker daemon on the host, so it has to be known before the stack starts.
#ACE_PORT_FLUENT_BIT=24224
#ACE_PORT_HTTP=8443
#ACE_PORT_HTTP_EXTERNAL=9443
#ACE_PORT_GUI=5000
#ACE_PORT_DEV_GUI=5001


# ---------------------------------------------------------------------------
# images
# ---------------------------------------------------------------------------

# Output image tags. Give a second instance its own tags, otherwise a `docker compose build`
# there retags the images this one recreates from.
#ACE3_IMAGE_URL=ace3:latest
#ACE3_PHISHKIT_IMAGE_URL=phishkit:latest
#ACE3_PHISHKIT_MANAGER_IMAGE_URL=phishkit-manager:latest
#ACE3_JS_DEOBFUSCATOR_IMAGE_URL=js-deobfuscator:latest
#ACE3_JS_DEOBFUSCATOR_MANAGER_IMAGE_URL=js-deobfuscator-manager:latest

# Pull third party base images from somewhere other than docker hub. Registry prefix only, no
# trailing slash.
#DOCKER_IMAGE_PREFIX=docker.io

# development | production
#BUILD_TYPE=development

# ---------------------------------------------------------------------------
# credentials -- auto-generated into the auth volume when unset
# ---------------------------------------------------------------------------

#SAQ_ENC=
#ACE_API_KEY=
#ACE_DB_USER_PASSWORD=
#ACE_SUPERUSER_DB_USER_PASSWORD=
#REDIS_PASSWORD=
#RABBITMQ_PASSWORD=
#QDRANT_API_KEY=
#FLASK_SECRET_KEY=

# ---------------------------------------------------------------------------
# misc
# ---------------------------------------------------------------------------

# Set to 1 on the primary node of a cluster (and in any standalone deployment).
#ACE_IS_PRIMARY_NODE=1

# Point these elsewhere if a service runs on a different host.
#ACE_DB_HOST=ace-db
#ACE_DB_READONLY_HOST=ace-db-readonly
#RABBITMQ_HOSTNAME=rabbitmq
#REDIS_HOSTNAME=redis
#QDRANT_HOSTNAME=qdrant

# Comma separated extra configuration files layered over etc/saq.default.yaml.
#SAQ_CONFIG_PATHS=

# uid/gid the containers run as. Match your host user to keep bind-mounted files writable.
#SAQ_USER_ID=1000
#SAQ_GROUP_ID=1000
