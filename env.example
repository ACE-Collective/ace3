# Copy to .env and edit to customize this instance.
#
# Variables here mirror ${VAR:-default} interpolation in docker-compose.yml.
# See that file for how each value is used by services.

# --- Application image tags (override for registry or local builds) ---

ACE3_IMAGE_URL=ace3:latest
ACE3_PHISHKIT_IMAGE_URL=phishkit:latest
ACE3_PHISHKIT_MANAGER_IMAGE_URL=phishkit-manager:latest
ACE3_JS_DEOBFUSCATOR_IMAGE_URL=js-deobfuscator:latest
ACE3_JS_DEOBFUSCATOR_MANAGER_IMAGE_URL=js-deobfuscator-manager:latest

# --- Base Docker images (mirror registry, pin versions) ---

PYTHON_DOCKER_IMAGE=python:3.12-trixie
MYSQL_DOCKER_IMAGE=mysql:9.2
NGINX_DOCKER_IMAGE=nginx:latest
RABBITMQ_DOCKER_IMAGE=rabbitmq
QDRANT_DOCKER_IMAGE=qdrant/qdrant
REDIS_DOCKER_IMAGE=redis:latest
DOCKER_IN_DOCKER_IMAGE=docker:dind
UBUNTU_DOCKER_IMAGE=ubuntu:22.04
FLUENT_BIT_DOCKER_IMAGE=fluent/fluent-bit:latest
NODE_DOCKER_IMAGE=node:20-alpine

# --- Secrets and crypto ---
# If unset in some setups, passwords may be auto-generated; see docker-compose.yml header.

SAQ_ENC=test
SAQ_CONFIG_PATHS=
ACE_API_KEY=
ACE_DB_USER_PASSWORD=
ACE_SUPERUSER_DB_USER_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
QDRANT_API_KEY=
FLASK_SECRET_KEY=

# --- Service hostnames (when not using default Docker network names) ---

ACE_DB_HOST=ace-db
ACE_DB_READONLY_HOST=ace-db-readonly
RABBITMQ_HOSTNAME=rabbitmq
REDIS_HOSTNAME=redis
QDRANT_HOSTNAME=qdrant

# --- Build and runtime identity ---

SAQ_USER_ID=1000
SAQ_GROUP_ID=1000
BUILD_TYPE=development
ACE_INSTANCE_TYPE=DEV
ACE_IS_PRIMARY_NODE=1

# --- Host port overrides ---
# Defaults match in-tree compose. Change when running a second checkout in parallel
# so instances do not collide on host ports. Container-side ports are unchanged.

ACE_FLUENT_BIT_PORT=24224
ACE_DB_PORT=3306
ACE_DB_READONLY_PORT=3307
ACE_HTTPS_EXTERNAL_PORT=9443
ACE_HTTPS_INTERNAL_PORT=8443
ACE_REDIS_PORT=6379
ACE_HTTP_DEBUG_PORT=5000
ACE_SEMAPHORE_PORT=53559
ACE_DEV_PORT=5001
ACE_RABBITMQ_PORT=5672
