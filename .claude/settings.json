{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/setup-worktree.sh --hook",
            "timeout": 120,
            "statusMessage": "Setting up the worktree"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/print-local-instructions.sh",
            "statusMessage": "Reading AGENTS.local.md",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
